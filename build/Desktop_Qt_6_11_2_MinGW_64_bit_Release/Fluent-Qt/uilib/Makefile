# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	cd /d D:\Qt_Project\BMS_temp1\build\Desktop_Qt_6_11_2_MinGW_64_bit_Release && $(CMAKE_COMMAND) -P D:\Qt_Project\BMS_temp1\build\Desktop_Qt_6_11_2_MinGW_64_bit_Release\CMakeFiles\VerifyGlobs.cmake
	cd /d D:\Qt_Project\BMS_temp1\build\Desktop_Qt_6_11_2_MinGW_64_bit_Release && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles\Makefile.cmake 0
.PHONY : cmake_check_build_system

